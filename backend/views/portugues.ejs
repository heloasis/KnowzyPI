<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quiz de Português</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg-1: #060d1f;
        --bg-2: #0a1235;
        --panel: rgba(15, 29, 62, 0.9);
        --panel-light: rgba(242, 242, 242, 0.92);
        --button-blue: #1d4bb5;
        --button-blue-strong: #1b3d9e;
        --primary: #8d5cf6;
        --primary-2: #6f90ff;
        --text: #f5f7ff;
        --muted: rgba(255, 255, 255, 0.75);
        --progress-bg: rgba(255, 255, 255, 0.18);
        --progress-fill: linear-gradient(90deg, #8e51ff 0%, #7a6dff 100%);
        --line: rgba(255, 255, 255, 0.12);
        --shadow: rgba(0, 0, 0, 0.2);
      }

      * {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        min-height: 100%;
        font-family: 'Inter', sans-serif;
        background: radial-gradient(circle at top, #0d1e41 0%, #060d1f 42%, #050814 100%);
        color: var(--text);
      }

      body {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 12px 16px;
      }

      .quiz-shell {
        position: relative;
        width: min(100%, 820px);
        min-height: 500px;
        max-height: calc(100vh - 24px);
        padding: 22px 22px 18px;
        background: linear-gradient(180deg, rgba(7, 16, 38, 0.92) 0%, rgba(10, 17, 32, 0.96) 100%);
        border: 1px solid rgba(146, 165, 255, 0.2);
        border-radius: 28px;
        box-shadow: 0 26px 70px rgba(0, 0, 0, 0.42);
        overflow: hidden;
      }

      .quiz-shell::before,
      .quiz-shell::after {
        content: "";
        position: absolute;
        width: 340px;
        height: 340px;
        border-radius: 50%;
        background: rgba(94, 118, 255, 0.08);
        filter: blur(8px);
      }

      .quiz-shell::before {
        left: -160px;
        top: -170px;
      }

      .quiz-shell::after {
        right: -140px;
        bottom: -180px;
      }

      .screen {
        position: relative;
        z-index: 1;
      }

      .hidden {
        display: none !important;
      }

      .close-btn {
        position: absolute;
        top: 18px;
        right: 18px;
        width: 50px;
        height: 50px;
        border: none;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
        font-size: 1.9rem;
        line-height: 1;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .quiz-header {
        padding-top: 18px;
        margin-bottom: 18px;
      }

      .quiz-header h1 {
        margin: 0;
        font-size: clamp(2rem, 3vw, 3rem);
        font-weight: 700;
        letter-spacing: -0.06em;
      }

      .progress-block {
        margin-top: 10px;
      }

      .progress-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        font-size: 0.9rem;
        color: var(--muted);
      }

      .progress-bar {
        position: relative;
        width: 100%;
        height: 12px;
        background: var(--progress-bg);
        border-radius: 999px;
        overflow: hidden;
      }

      .progress-fill {
        position: absolute;
        inset: 0 auto 0 0;
        width: 0%;
        border-radius: inherit;
        background: var(--progress-fill);
        transition: width 0.25s ease;
      }

      .question-card {
        margin-top: 18px;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 18px;
        padding: 18px 18px 20px;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5);
      }

      .question-text {
        margin: 0 0 18px;
        color: #1e2330;
        font-size: clamp(1.4rem, 2.2vw, 2.2rem);
        line-height: 1.2;
        font-weight: 500;
        letter-spacing: -0.04em;
      }

      .answers {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .answer-btn {
        width: 100%;
        border: 2px solid rgba(31, 74, 170, 0.9);
        border-radius: 16px;
        padding: 14px 16px;
        background: rgba(255, 255, 255, 0.12);
        color: #1a2e6d;
        font-size: clamp(1rem, 1.7vw, 1.45rem);
        font-weight: 500;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .answer-btn.selected {
        background: linear-gradient(135deg, #1d4bb5 0%, #0d2c82 100%);
        color: #fff;
        border-color: #1d4bb5;
        box-shadow: 0 10px 18px rgba(29, 75, 181, 0.25);
      }

      .answer-btn.correct {
        background: #14b86a;
        border-color: #14b86a;
        color: #fff;
      }

      .answer-btn.wrong {
        background: #e74d4d;
        border-color: #e74d4d;
        color: #fff;
      }

      .confirm-btn {
        margin-top: 16px;
        width: 100%;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #8a57ff, #5f6cff);
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
        padding: 14px 18px;
        cursor: pointer;
        box-shadow: 0 10px 20px rgba(127, 105, 255, 0.34);
      }

      .confirm-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .result-screen {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 360px;
        padding-top: 12px;
      }

      .brand-mark {
        width: 52px;
        height: 52px;
        align-self: flex-start;
        margin-left: 10px;
        margin-bottom: 12px;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(255,255,255,0.12), rgba(142, 92, 246, 0.18));
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(168, 174, 255, 0.22);
        color: #9fe3ff;
        font-size: 1.8rem;
        font-weight: 700;
      }

      .result-title {
        margin: 0 0 18px;
        font-size: clamp(2.5rem, 8vw, 4rem);
        line-height: 0.9;
        letter-spacing: -0.07em;
        font-weight: 700;
        background: linear-gradient(135deg, #8c6bff, #70d7ff 70%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        text-align: center;
      }

      .result-circle {
        width: min(72vw, 310px);
        aspect-ratio: 1;
        border-radius: 50%;
        background: rgba(226, 231, 242, 0.92);
        color: #1d2440;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.5);
        margin: 0 auto 22px;
      }

      .result-score {
        display: block;
        font-size: clamp(1.35rem, 5vw, 2.5rem);
        line-height: 1.2;
        font-weight: 700;
      }

      .result-score strong {
        display: block;
        font-size: clamp(1.6rem, 6vw, 2.8rem);
      }

      .result-actions {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 10px;
      }

      .result-action {
        width: 100%;
        border: none;
        border-radius: 18px;
        padding: 15px 16px;
        font-size: clamp(1.15rem, 3vw, 1.7rem);
        line-height: 1.2;
        font-weight: 500;
        cursor: pointer;
      }

      .result-action.primary {
        background: linear-gradient(135deg, #2d58c3, #1b3c99);
        color: #fff;
      }

      .result-action.secondary {
        background: rgba(255, 255, 255, 0.92);
        color: #1d2a4b;
      }

      .result-action.ghost {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.15);
      }

      @media (max-width: 420px) {
        body {
          padding: 14px;
        }

        .quiz-shell {
          border-radius: 22px;
          min-height: 100vh;
          padding-left: 16px;
          padding-right: 16px;
        }

        .question-card {
          border-radius: 16px;
          padding: 18px 14px 20px;
        }
      }
    </style>
  </head>
  <body>
    <main class="quiz-shell">
      <section id="quizScreen" class="screen">
        <button class="close-btn" type="button" aria-label="Voltar para matérias" onclick="window.location.href='/materias'">←</button>

        <header class="quiz-header">
          <h1 id="materiaTitle">Português</h1>
        </header>

        <div class="progress-block">
          <div class="progress-top">
            <span id="progressText">Pergunta 1 de 12</span>
          </div>
          <div class="progress-bar" aria-label="Progresso do quiz">
            <div id="progressFill" class="progress-fill"></div>
          </div>
        </div>

        <div class="question-card">
          <p id="questionText" class="question-text">Carregando pergunta…</p>
          <div id="answers" class="answers"></div>
          <button id="confirmBtn" class="confirm-btn" type="button" disabled>Confirmar</button>
        </div>
      </section>

      <section id="resultScreen" class="screen result-screen hidden">
        <div class="brand-mark">✦</div>
        <h2 class="result-title">parabéns</h2>

        <div class="result-circle">
          <div class="result-score">
            Resultado
            <strong id="scoreValue">0/12</strong>
          </div>
        </div>

        <div class="result-actions">
          <button class="result-action secondary" type="button" onclick="restartQuiz()">Jogar novamente</button>
          <button class="result-action ghost" type="button" onclick="window.location.href='/home/conquistas'">Conquistas</button>
          <button class="result-action primary" type="button" onclick="window.location.href='/home'">Voltar</button>
        </div>
      </section>
    </main>

    <script>
      const firebaseUrl = 'https://knowzypi-default-rtdb.firebaseio.com/materias/portugues/perguntas.json';
      const fallbackQuestions = [
        {
          id: 'q1',
          enunciado: 'Qual palavra está corretamente grafada?',
          alternativas: ['Acessorio', 'Acessório', 'Acessorio', 'Acessóro'],
          resposta_correta: 1
        },
        {
          id: 'q2',
          enunciado: 'Qual frase está correta?',
          alternativas: ['Eu fui ao mercado.', 'Eu fui no mercado.', 'Eu fui a mercado.', 'Eu fui em mercado.'],
          resposta_correta: 0
        },
        {
          id: 'q3',
          enunciado: 'Qual opção apresenta somente verbos no passado?',
          alternativas: ['Corri, falei, cheguei', 'Corro, falo, chego', 'Correr, falar, chegar', 'Corra, fale, chegue'],
          resposta_correta: 0
        }
      ];

      const quizScreen = document.getElementById('quizScreen');
      const resultScreen = document.getElementById('resultScreen');
      const questionText = document.getElementById('questionText');
      const answers = document.getElementById('answers');
      const confirmBtn = document.getElementById('confirmBtn');
      const progressText = document.getElementById('progressText');
      const progressFill = document.getElementById('progressFill');
      const scoreValue = document.getElementById('scoreValue');
      const materiaTitle = document.getElementById('materiaTitle');

      let perguntas = [];
      let currentIndex = 0;
      let selectedIndex = null;
      let acertos = 0;

      function normalizarPergunta(item, index) {
        const respostaCorreta = typeof item.resposta_correta === 'number'
          ? item.resposta_correta
          : Number(item.respostaCorreta ?? 0);

        return {
          id: item.id || `q${index + 1}`,
          enunciado: item.enunciado || 'Pergunta sem enunciado.',
          alternativas: Array.isArray(item.alternativas) ? item.alternativas : [],
          resposta_correta: Number.isInteger(respostaCorreta) ? respostaCorreta : 0
        };
      }

      function setScreen(screen) {
        quizScreen.classList.toggle('hidden', screen !== 'quiz');
        resultScreen.classList.toggle('hidden', screen !== 'result');
      }

      function updateProgress() {
        const total = perguntas.length || 1;
        const atual = currentIndex + 1;
        progressText.textContent = `Pergunta ${atual} de ${total}`;
        progressFill.style.width = `${(atual / total) * 100}%`;
      }

      function renderQuestion() {
        const perguntaAtual = perguntas[currentIndex];
        if (!perguntaAtual) {
          finishQuiz();
          return;
        }

        selectedIndex = null;
        confirmBtn.disabled = true;
        questionText.textContent = perguntaAtual.enunciado;
        answers.innerHTML = '';

        perguntaAtual.alternativas.forEach((alternativa, index) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'answer-btn';
          button.textContent = alternativa;
          button.setAttribute('data-index', String(index));

          button.addEventListener('click', () => {
            selectedIndex = index;
            document.querySelectorAll('.answer-btn').forEach((el) => {
              el.classList.toggle('selected', Number(el.dataset.index) === selectedIndex);
            });
            confirmBtn.disabled = false;
          });

          answers.appendChild(button);
        });

        updateProgress();
      }

      function confirmarResposta() {
        if (selectedIndex === null) return;

        const perguntaAtual = perguntas[currentIndex];
        const respostaCorreta = perguntaAtual.resposta_correta;
        const buttons = document.querySelectorAll('.answer-btn');

        buttons.forEach((button) => {
          const index = Number(button.dataset.index);
          button.disabled = true;

          if (index === respostaCorreta) button.classList.add('correct');
          if (index === selectedIndex && index !== respostaCorreta) button.classList.add('wrong');
        });

        if (selectedIndex === respostaCorreta) {
          acertos += 1;
          const ganho = 10;
          const xpAtual = Number(JSON.parse(localStorage.getItem('profileData') || '{}').xpTotal || 0);
          const proximoXp = xpAtual + ganho;
          const dados = {
            nome: JSON.parse(localStorage.getItem('profileData') || '{}').nome || 'Aluno Teste',
            tag: JSON.parse(localStorage.getItem('profileData') || '{}').tag || '#A12',
            xpTotal: proximoXp,
            nivel: proximoXp >= 3000 ? 'Lenda' : proximoXp >= 1500 ? 'Mestre' : proximoXp >= 1000 ? 'Sábio' : proximoXp >= 500 ? 'Aventureiro' : 'Iniciante',
            conquistas: JSON.parse(localStorage.getItem('profileData') || '{}').conquistas || '0 / 0',
            mascote: JSON.parse(localStorage.getItem('profileData') || '{}').mascote || '🐾',
            style: JSON.parse(localStorage.getItem('profileData') || '{}').style || 'Manto Azul',
            accessory: JSON.parse(localStorage.getItem('profileData') || '{}').accessory || 'Óculos',
            mood: JSON.parse(localStorage.getItem('profileData') || '{}').mood || 'Feliz',
            theme: 'Ativo'
          };
          localStorage.setItem('profileData', JSON.stringify(dados));
        }

        confirmBtn.textContent = currentIndex === perguntas.length - 1 ? 'Ver resultado' : 'Próxima';
        confirmBtn.disabled = false;

        confirmBtn.onclick = () => {
          currentIndex += 1;
          if (currentIndex < perguntas.length) {
            confirmBtn.textContent = 'Confirmar';
            confirmBtn.onclick = confirmarResposta;
            renderQuestion();
          } else {
            finishQuiz();
          }
        };
      }

      function finishQuiz() {
        setScreen('result');
        scoreValue.textContent = `${acertos}/${perguntas.length}`;
      }

      function restartQuiz() {
        currentIndex = 0;
        selectedIndex = null;
        acertos = 0;
        setScreen('quiz');
        confirmBtn.textContent = 'Confirmar';
        confirmBtn.onclick = confirmarResposta;
        renderQuestion();
      }

      async function buscarPerguntas() {
        try {
          const response = await fetch(firebaseUrl);
          if (!response.ok) throw new Error('Erro ao carregar perguntas');

          const dados = await response.json();
          const perguntasNormalizadas = Object.values(dados || {}).map(normalizarPergunta);
          perguntas = perguntasNormalizadas.length ? perguntasNormalizadas : fallbackQuestions.map(normalizarPergunta);
        } catch (error) {
          perguntas = fallbackQuestions.map(normalizarPergunta);
        }

        materiaTitle.textContent = 'Português';
        renderQuestion();
      }

      confirmBtn.onclick = confirmarResposta;
      buscarPerguntas();
    </script>
  </body>
</html>
