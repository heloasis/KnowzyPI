<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home - App Quiz</title>
  <link rel="stylesheet" href="/css/home.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <div class="background">
    <div class="arc arc1"></div>
    <div class="arc arc2"></div>
    <div class="arc arc3"></div>

    <span class="star s1"></span>
    <span class="star s2"></span>
    <span class="star s3"></span>
    <span class="star s4"></span>
    <span class="star s5"></span>
  </div>

  <main class="dashboard-container">
    <div class="top-logo-wrap">
      <img src="/imagens/image.png" alt="Logo Knowzy" class="top-logo" />
    </div>

    <header class="user-card top-bar">
      <div class="user-info">
        <div class="avatar">
          <i class="fa-regular fa-user"></i>
        </div>
        <h2>
          <a href="/perfil" class="welcome-link">Olá, Usuário!</a>
        </h2>
      </div>
      <a href="/perfil" class="icon-btn" aria-label="Perfil">
        <i class="fa-solid fa-gear"></i>
      </a>
    </header>

    <section class="menu-grid">
      
      <a href="/favoritos" class="menu-card">
        <div class="card-icon">
          <i class="fa-regular fa-heart"></i>
        </div>
        <span>Favoritos</span>
      </a>

      <a href="/materias" class="menu-card">
        <div class="card-icon">
          <i class="fa-solid fa-bullseye"></i>
        </div>
        <span>Quiz</span>
      </a>

      <a href="/conquistas" class="menu-card">
        <div class="card-icon">
          <i class="fa-regular fa-star"></i>
        </div>
        <span>Conquistas</span>
      </a>

    </section>

  </main>

</body>
</html>