<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= materia.nome %> | KnowzyPI</title><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"><style>
*{box-sizing:border-box}body{margin:0;min-height:100vh;background:#060312;color:#f7f7ff;font-family:Inter, sans-serif;padding:28px 18px}.wrap{max-width:940px;margin:auto}.back{color:#b8c7ff;text-decoration:none}.eyebrow{color:#a99bff;letter-spacing:2px;font-size:12px;font-weight:700;margin-top:35px}.title{font-size:clamp(30px,5vw,46px);margin:8px 0}.desc{color:#b8bfdc;line-height:1.7}.topic{margin:18px 0;padding:24px;border:1px solid #28345f;border-radius:20px;background:linear-gradient(140deg,#111b3d,#0b1026)}.topic h2{margin:0 0 12px;font-size:22px}.topic p{line-height:1.75;color:#d9def2}.example{padding:13px 16px;background:#1b2450;border-left:3px solid #8e73ff;border-radius:8px;color:#e8e5ff}.done{display:flex;gap:10px;align-items:center;color:#c8d0f3;font-size:14px;margin-top:16px}.done input{width:18px;height:18px;accent-color:#8e73ff}.actions{display:flex;gap:12px;flex-wrap:wrap;margin:26px 0}.btn{padding:13px 18px;border-radius:12px;background:#5269a5;color:white;text-decoration:none;font-weight:700}.coming-soon{padding:13px 18px;border-radius:12px;background:#251b55;color:#d7ceff;font-weight:700}
</style></head><body><main class="wrap"><a class="back" href="/materias">← Voltar para matérias</a><div class="eyebrow">TRILHA DE APRENDIZADO</div><h1 class="title"><%= materia.nome %></h1><p class="desc"><%= materia.descricao %>. Estude os tópicos no seu ritmo e marque cada um quando terminar.</p><div id="topics"><% materia.topicos.forEach((topico)=>{ %><article class="topic" data-topic="<%= topico.id %>"><h2><%= topico.titulo %></h2><p><%= topico.explicacao %></p><div class="example"><strong>Exemplo / aplicação:</strong> <%= topico.exemplo %></div><label class="done"><input type="checkbox" class="topic-done"> Marcar como estudado</label></article><% }); %></div><div class="actions"><a class="btn" href="/quiz/<%= materia.id %>">Praticar no quiz →</a><span class="coming-soon">Tutor IA — em breve</span></div></main><script>
const key='knowzyEstudos';let progress={};try{progress=JSON.parse(localStorage.getItem(key)||'{}')}catch(e){};const subject='<%= materia.id %>';document.querySelectorAll('.topic').forEach(card=>{const id=card.dataset.topic;const input=card.querySelector('input');input.checked=!!progress[subject]?.[id];input.addEventListener('change',()=>{progress[subject]=progress[subject]||{};progress[subject][id]=input.checked;localStorage.setItem(key,JSON.stringify(progress));});});
</script></body></html>