
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quiz de Biologia</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
      :root {
        --bg-1: #060d1f;
        --bg-2: #0a1235;
        --panel: rgba(15, 29, 62, 0.9);
        --text: #f5f7ff;
        --muted: rgba(255, 255, 255, 0.75);
        --progress-bg: rgba(255, 255, 255, 0.18);
        --progress-fill: linear-gradient(90deg, #8e51ff 0%, #7a6dff 100%);
      }

      * {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        min-height: 100%;
        font-family: 'Inter', sans-serif;
        background: radial-gradient(circle at top, #0d1e41 0%, #060d1f 42%, #050814 100%);
        color: var(--text);
      }

      body {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 16px;
      }

      .quiz-shell {
        position: relative;
        width: min(100%, 820px);
        min-height: 500px;
        padding: 26px 26px 24px;
        background: linear-gradient(180deg, rgba(7, 16, 38, 0.92) 0%, rgba(10, 17, 32, 0.96) 100%);
        border: 1px solid rgba(146, 165, 255, 0.2);
        border-radius: 28px;
        box-shadow: 0 26px 70px rgba(0, 0, 0, 0.42);
        overflow: hidden;
      }

      .quiz-shell::before,
      .quiz-shell::after {
        content: "";
        position: absolute;
        width: 340px;
        height: 340px;
        border-radius: 50%;
        background: rgba(94, 118, 255, 0.08);
        filter: blur(8px);
        pointer-events: none;
      }

      .quiz-shell::before {
        left: -160px;
        top: -170px;
      }

      .quiz-shell::after {
        right: -140px;
        bottom: -180px;
      }

      .screen {
        position: relative;
        z-index: 1;
      }

      .hidden {
        display: none !important;
      }

      .close-btn {
        position: absolute;
        top: 18px;
        right: 18px;
        width: 50px;
        height: 50px;
        border: none;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
        font-size: 1.9rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .quiz-header {
        padding-top: 18px;
        margin-bottom: 22px;
      }

      .quiz-header h1 {
        margin: 0;
        font-size: clamp(2rem, 3vw, 3rem);
        font-weight: 700;
        letter-spacing: -0.06em;
      }

      .progress-block {
        margin-top: 10px;
      }

      .progress-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        font-size: 0.95rem;
        color: var(--muted);
      }

      .progress-bar {
        position: relative;
        width: 100%;
        height: 12px;
        background: var(--progress-bg);
        border-radius: 999px;
        overflow: hidden;
      }

      .progress-fill {
        position: absolute;
        inset: 0 auto 0 0;
        width: 0%;
        border-radius: inherit;
        background: var(--progress-fill);
        transition: width 0.25s ease;
      }

      .question-card {
        margin-top: 22px;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        padding: 24px 22px;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5);
      }

      .question-text {
        margin: 0 0 22px;
        color: #1e2330;
        font-size: clamp(1.4rem, 2.2vw, 2.2rem);
        line-height: 1.3;
        font-weight: 600;
        letter-spacing: -0.04em;
      }

      .answers {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .answer-btn {
        width: 100%;
        min-height: 66px;
        border: 2px solid rgba(31, 74, 170, 0.9);
        border-radius: 16px;
        padding: 18px 22px;
        background: rgba(255,255,255,0.12);
        color: #1a2e6d;
        font-size: clamp(1.05rem, 1.8vw, 1.35rem);
        font-weight: 600;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .answer-btn.selected {
        background: linear-gradient(135deg, #1d4bb5 0%, #0d2c82 100%);
        color: #fff;
        border-color: #1d4bb5;
        box-shadow: 0 10px 18px rgba(29, 75, 181, 0.25);
      }

      .answer-btn.correct {
        background: #14b86a;
        border-color: #14b86a;
        color: #fff;
      }

      .answer-btn.wrong {
        background: #e74d4d;
        border-color: #e74d4d;
        color: #fff;
      }

      .confirm-btn {
        margin-top: 22px;
        width: 100%;
        min-height: 66px;
        border: none;
        border-radius: 16px;
        background: linear-gradient(135deg, #8a57ff, #5f6cff);
        color: #fff;
        font-size: 1.2rem;
        font-weight: 700;
        padding: 18px 24px;
        cursor: pointer;
        box-shadow: 0 10px 20px rgba(127, 105, 255, 0.34);
      }

      .confirm-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .result-screen {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 460px;
        padding: 20px 0;
      }

      .brand-mark {
        width: 52px;
        height: 52px;
        margin-bottom: 16px;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(255,255,255,0.12), rgba(142, 92, 246, 0.18));
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(168, 174, 255, 0.22);
        color: #9fe3ff;
        font-size: 1.8rem;
        font-weight: 700;
      }

      .result-title {
        margin: 0 0 12px;
        font-size: clamp(2.2rem, 7vw, 3.7rem);
        line-height: 1.05;
        letter-spacing: -0.07em;
        font-weight: 800;
        background: linear-gradient(135deg, #8c6bff, #70d7ff 70%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        text-align: center;
      }

      .result-description {
        max-width: 500px;
        margin: 0 auto 22px;
        color: rgba(255,255,255,0.85);
        font-size: 1.05rem;
        line-height: 1.6;
        text-align: center;
      }

      .result-circle {
        width: min(52vw, 230px);
        aspect-ratio: 1;
        border-radius: 50%;
        background: rgba(226, 231, 242, 0.92);
        color: #1d2440;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.5);
        margin: 0 auto 20px;
      }

      .result-score {
        display: block;
        font-size: clamp(1.35rem, 5vw, 2rem);
        line-height: 1.2;
        font-weight: 700;
      }

      .result-score strong {
        display: block;
        font-size: clamp(1.8rem, 6vw, 2.7rem);
        margin-top: 6px;
      }

      .result-actions {
        width: 100%;
        max-width: 560px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin: 10px auto 0;
      }

      .result-action {
        width: 100%;
        min-height: 64px;
        border: none;
        border-radius: 18px;
        padding: 18px 22px;
        font-size: 1.15rem;
        line-height: 1.2;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s ease, opacity 0.2s ease;
      }

      .result-action:hover {
        transform: translateY(-2px);
      }

      .result-action.primary {
        background: linear-gradient(135deg, #2d58c3, #1b3c99);
        color: #fff;
      }

      .result-action.secondary {
        background: rgba(255, 255, 255, 0.92);
        color: #1d2a4b;
      }

      .result-action.ghost {
        background: rgba(255,255,255,0.1);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.15);
      }

      @media (max-width: 600px) {
        body {
          padding: 10px;
          align-items: flex-start;
        }

        .quiz-shell {
          width: 100%;
          min-height: calc(100vh - 20px);
          padding: 20px 16px;
          border-radius: 22px;
        }

        .question-card {
          padding: 20px 14px;
        }

        .answer-btn,
        .confirm-btn,
        .result-action {
          min-height: 60px;
          font-size: 1rem;
        }

        .result-screen {
          min-height: 0;
          padding: 35px 0;
        }

        .result-circle {
          width: min(58vw, 210px);
        }
      }
    </style>
  </head>

  <body>
    <main class="quiz-shell">

      <section id="quizScreen" class="screen">
        <button
          class="close-btn"
          type="button"
          aria-label="Voltar para matérias"
          onclick="window.location.href='/quiz'"
        >←</button>

        <header class="quiz-header">
          <h1 id="materiaTitle">Biologia</h1>
        </header>

        <div class="progress-block">
          <div class="progress-top">
            <span id="progressText">Pergunta 1 de 12</span>
          </div>

          <div class="progress-bar" aria-label="Progresso do quiz">
            <div id="progressFill" class="progress-fill"></div>
          </div>
        </div>

        <div class="question-card">
          <p id="questionText" class="question-text">Carregando pergunta…</p>

          <div id="answers" class="answers"></div>

          <button
            id="confirmBtn"
            class="confirm-btn"
            type="button"
            disabled
          >Confirmar</button>
        </div>
      </section>

      <section id="resultScreen" class="screen result-screen hidden">
        <div class="brand-mark">✦</div>

        <h2 class="result-title" id="resultTitle">Seu resultado</h2>

        <p class="result-description" id="resultDescription">
          Confira seu desempenho!
        </p>

        <div class="result-circle">
          <div class="result-score">
            Resultado
            <strong id="scoreValue">0/12</strong>
          </div>
        </div>

        <div class="result-actions">
          <button
            class="result-action secondary"
            type="button"
            onclick="restartQuiz()"
          >Jogar novamente</button>

          <button
            class="result-action ghost"
            type="button"
            onclick="window.location.href='/home/conquistas'"
          >Conquistas</button>

          <button
            class="result-action primary"
            type="button"
            onclick="window.location.href='/home'"
          >Voltar</button>
        </div>
      </section>

    </main>

  
<script>
  const firebaseUrl = 'https://knowzypi-default-rtdb.firebaseio.com/materias/biologia/perguntas.json';

  const fallbackQuestions = [
    {
      id: 'q1',
      enunciado: 'Qual órgão do corpo humano bombeia o sangue?',
      alternativas: ['Pulmão', 'Coração', 'Fígado', 'Rim'],
      resposta_correta: 1
    },
    {
      id: 'q2',
      enunciado: 'Qual processo permite as plantas produzirem seu próprio alimento?',
      alternativas: ['Respiração', 'Fotossíntese', 'Digestão', 'Transpiração'],
      resposta_correta: 1
    },
    {
      id: 'q3',
      enunciado: 'Qual é a unidade básica da vida?',
      alternativas: ['Tecido', 'Órgão', 'Célula', 'Molécula'],
      resposta_correta: 2
    }
  ];

  const quizScreen = document.getElementById('quizScreen');
  const resultScreen = document.getElementById('resultScreen');
  const questionText = document.getElementById('questionText');
  const answers = document.getElementById('answers');
  const confirmBtn = document.getElementById('confirmBtn');
  const progressText = document.getElementById('progressText');
  const progressFill = document.getElementById('progressFill');
  const scoreValue = document.getElementById('scoreValue');
  const materiaTitle = document.getElementById('materiaTitle');

  let perguntas = [];
  let currentIndex = 0;
  let selectedIndex = null;
  let acertos = 0;
  let resultadoSalvo = false;
  let progressoEnviado = false;
  let respostas = [];

  const USER_KEY = <%- JSON.stringify(usuario?.id || 'preview') %>;
  const CHAVE_PERFIL = `profileData:${USER_KEY}`;
  const CHAVE_QUESTOES = `knowzy:${USER_KEY}:questoesPontuadas`;
  const CHAVE_RESULTADOS = `knowzy:${USER_KEY}:quizResults`;

  function lerLocalStorage(chave, padrao) {
    try {
      const dados = localStorage.getItem(chave);
      return dados ? JSON.parse(dados) : padrao;
    } catch (error) {
      console.warn('Erro ao ler armazenamento local:', error);
      return padrao;
    }
  }

  function salvarLocalStorage(chave, dados) {
    try {
      localStorage.setItem(chave, JSON.stringify(dados));
      return true;
    } catch (error) {
      console.error('Erro ao salvar armazenamento local:', error);
      return false;
    }
  }

  function normalizarPergunta(item, index) {
    const respostaCorreta =
      typeof item.resposta_correta === 'number'
        ? item.resposta_correta
        : Number(item.respostaCorreta ?? item.resposta_correta ?? 0);

    return {
      id: String(item.id || `q${index + 1}`),
      enunciado: item.enunciado || 'Pergunta sem enunciado.',
      alternativas: Array.isArray(item.alternativas)
        ? item.alternativas
        : [],
      resposta_correta: Number.isInteger(respostaCorreta)
        ? respostaCorreta
        : 0
    };
  }

  function setScreen(screen) {
    quizScreen.classList.toggle('hidden', screen !== 'quiz');
    resultScreen.classList.toggle('hidden', screen !== 'result');
  }

  function updateProgress() {
    const total = perguntas.length || 1;
    const atual = currentIndex + 1;

    progressText.textContent = `Pergunta ${atual} de ${total}`;
    progressFill.style.width = `${(atual / total) * 100}%`;
  }

  function atualizarXpLocal(perguntaId) {
    const pontuadas = lerLocalStorage(CHAVE_QUESTOES, {});
    const chave = `biologia_${perguntaId}`;

    // A mesma questão não gera XP duas vezes.
    if (pontuadas[chave]) return;

    pontuadas[chave] = true;
    salvarLocalStorage(CHAVE_QUESTOES, pontuadas);

    const perfil = lerLocalStorage(CHAVE_PERFIL, {});
    const xpAtual = Number(perfil.xpTotal ?? perfil.xp ?? 0);
    const novoXp = xpAtual + 5;

    perfil.xp = novoXp;
    perfil.xpTotal = novoXp;

    perfil.nivel =
      novoXp >= 3000 ? 'Lenda' :
      novoXp >= 1500 ? 'Mestre' :
      novoXp >= 1000 ? 'Sábio' :
      novoXp >= 500 ? 'Aventureiro' :
      'Iniciante';

    salvarLocalStorage(CHAVE_PERFIL, perfil);
  }

  async function sincronizarComServidor() {
    if (progressoEnviado) return;
    progressoEnviado = true;
    const pendingKey = `knowzy:${USER_KEY}:quizPendentes`;
    const pending = lerLocalStorage(pendingKey, []);
    if (respostas.length) pending.push({ materiaId: 'biologia', respostas: respostas.slice(), criadoEm: new Date().toISOString() });
    salvarLocalStorage(pendingKey, pending);
    for (let i = 0; i < pending.length; i++) {
      const item = pending[i];
      try {
        const response = await fetch('/quiz/finalizar', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ materiaId: item.materiaId, respostas: item.respostas }) });
        const resultado = await response.json();
        if (!response.ok) throw new Error(resultado.erro || `Servidor respondeu com status ${response.status}`);
        const perfil = lerLocalStorage(CHAVE_PERFIL, {});
        const xpFinal = Number(resultado.xpTotal || 0); // Total autoritativo do backend após sincronizar a fila pendente.
        perfil.xp = xpFinal; perfil.xpTotal = xpFinal;
        perfil.nivel = xpFinal >= 3000 ? 'Lenda' : xpFinal >= 1500 ? 'Mestre' : xpFinal >= 1000 ? 'Sábio' : xpFinal >= 500 ? 'Aventureiro' : 'Iniciante';
        salvarLocalStorage(CHAVE_PERFIL, perfil);
        pending.splice(i, 1); i--; salvarLocalStorage(pendingKey, pending);
      } catch (error) { console.warn('Sincronização pendente; progresso local preservado.', error); break; }
    }
  }

  function renderQuestion() {
    const perguntaAtual = perguntas[currentIndex];

    if (!perguntaAtual) {
      finishQuiz();
      return;
    }

    selectedIndex = null;
    confirmBtn.disabled = true;
    confirmBtn.textContent = 'Confirmar';
    confirmBtn.onclick = confirmarResposta;

    questionText.textContent = perguntaAtual.enunciado;
    answers.innerHTML = '';

    perguntaAtual.alternativas.forEach((alternativa, index) => {
      const button = document.createElement('button');

      button.type = 'button';
      button.className = 'answer-btn';
      button.textContent = alternativa;
      button.setAttribute('data-index', String(index));

      button.addEventListener('click', () => {
        selectedIndex = index;

        document.querySelectorAll('.answer-btn').forEach((el) => {
          el.classList.toggle(
            'selected',
            Number(el.dataset.index) === selectedIndex
          );
        });

        confirmBtn.disabled = false;
      });

      answers.appendChild(button);
    });

    updateProgress();
  }

  function confirmarResposta() {
    if (selectedIndex === null) return;

    const perguntaAtual = perguntas[currentIndex];
    const respostaCorreta = perguntaAtual.resposta_correta;
    const buttons = document.querySelectorAll('.answer-btn');

    respostas.push({
      perguntaId: String(perguntaAtual.id),
      resposta: String(selectedIndex)
    });

    buttons.forEach((button) => {
      const index = Number(button.dataset.index);

      button.disabled = true;

      if (index === respostaCorreta) {
        button.classList.add('correct');
      }

      if (index === selectedIndex && index !== respostaCorreta) {
        button.classList.add('wrong');
      }
    });

    if (selectedIndex === respostaCorreta) {
      acertos += 1;
      atualizarXpLocal(perguntaAtual.id);
    }

    confirmBtn.textContent =
      currentIndex === perguntas.length - 1
        ? 'Ver resultado'
        : 'Próxima';

    confirmBtn.disabled = false;

    confirmBtn.onclick = () => {
      currentIndex += 1;

      if (currentIndex < perguntas.length) {
        renderQuestion();
      } else {
        finishQuiz();
      }
    };
  }

  function finishQuiz() {
    setScreen('result');

    const total = perguntas.length;
    const porcentagem = total > 0
      ? Math.round((acertos / total) * 100)
      : 0;

    scoreValue.textContent = `${acertos}/${total}`;

    const resultTitle = document.getElementById('resultTitle');
    const resultDescription = document.getElementById('resultDescription');

    if (porcentagem < 40) {
      resultTitle.textContent = 'Vamos por partes!';
      resultDescription.textContent =
        'Ainda há conteúdo para revisar. Não desanime! Retome os estudos e tente novamente.';
    } else if (porcentagem < 70) {
      resultTitle.textContent = 'Você está evoluindo!';
      resultDescription.textContent =
        'Você já avançou em alguns pontos. Continue praticando para melhorar ainda mais.';
    } else if (porcentagem < 90) {
      resultTitle.textContent = 'Muito bem!';
      resultDescription.textContent =
        'Você demonstrou um bom domínio do conteúdo. Continue assim!';
    } else {
      resultTitle.textContent = 'Incrível!';
      resultDescription.textContent =
        'Excelente desempenho! Você demonstrou um ótimo domínio dessa matéria.';
    }

    if (resultadoSalvo) return;

    const resultados = lerLocalStorage(CHAVE_RESULTADOS, []);

    resultados.unshift({
      materia: 'Biologia',
      acertos,
      total,
      porcentagem,
      data: new Date().toISOString()
    });

    salvarLocalStorage(
      CHAVE_RESULTADOS,
      resultados.slice(0, 50)
    );

    resultadoSalvo = true;

    sincronizarComServidor();
  }

  function restartQuiz() {
    currentIndex = 0;
    selectedIndex = null;
    acertos = 0;
    resultadoSalvo = false;
    progressoEnviado = false;
    respostas = [];

    confirmBtn.textContent = 'Confirmar';
    confirmBtn.onclick = confirmarResposta;

    setScreen('quiz');
    renderQuestion();
  }

  async function buscarPerguntas() {
    try {
      const response = await fetch(firebaseUrl);

      if (!response.ok) {
        throw new Error('Erro ao carregar perguntas');
      }

      const dados = await response.json();

      const perguntasNormalizadas = Array.isArray(dados)
        ? dados.map((item, index) =>
            normalizarPergunta(item || {}, index)
          )
        : Object.entries(dados || {}).map(([id, item], index) =>
            normalizarPergunta({ ...item, id: item.id || id }, index)
          );

      perguntas = perguntasNormalizadas.length
        ? perguntasNormalizadas
        : fallbackQuestions.map(normalizarPergunta);

    } catch (error) {
      console.warn(
        'Não foi possível buscar no Firebase. Usando perguntas de demonstração.',
        error
      );

      perguntas = fallbackQuestions.map(normalizarPergunta);
    }

    materiaTitle.textContent = 'Biologia';
    renderQuestion();
  }

  confirmBtn.onclick = confirmarResposta;

  buscarPerguntas();
</script>

  </body>
</html>
